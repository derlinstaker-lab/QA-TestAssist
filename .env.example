# ─────────────────────────────────────────────
# QA Test Assist — Environment Variables
# Copy this file to .env and fill in your values
# .env is gitignored and never committed
# ─────────────────────────────────────────────

# ── AWS S3 Deployment ──────────────────────
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# CloudFront distribution ID (optional — triggers cache invalidation on deploy)
CF_DISTRIBUTION_ID=E1234ABCDEF

# ── Netlify Deployment ─────────────────────
NETLIFY_AUTH_TOKEN=...
NETLIFY_SITE_ID=...

# ── Build ──────────────────────────────────
NODE_ENV=development

# ── Postman (dev server) ───────────────────
# API key for the Postman API (env/collection sync + /api/run)
POSTMAN_API_KEY=PMAK-...
# Optional: path to the Postman CLI binary, if not on the default macOS Homebrew path
# POSTMAN_CLI=/opt/homebrew/bin/postman

# ── Link sync (dev server) ─────────────────
# Optional: path to the Claude Code CLI used by "Get from Link" (defaults to ~/.local/bin/claude).
# It must be signed in with the claude.ai Link connector connected (`claude mcp list`).
# CLAUDE_CLI=/Users/you/.local/bin/claude
# Optional: per-click spending cap in USD for that headless run (default 3)
# LINK_SYNC_MAX_USD=3
